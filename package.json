{
  "name": "fake-paper-doll-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:build": "node scripts/build-character-assets.mjs",
    "assets:check": "node scripts/build-character-assets.mjs --check",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "verify:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run assets:check && npm run test && npm run build && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
